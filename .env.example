NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Outreach (admin → Outreach) ---
# Secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>" to /api/outreach/run
CRON_SECRET=generate_a_long_random_string
# Model drafting (optional; without it drafts use templates and replies are not auto-drafted)
ANTHROPIC_API_KEY=
# OUTREACH_MODEL=claude-opus-5-5
# Zoho mailbox used for cold email (app password, same as the Python script used)
ZOHO_SMTP_USER=sales@hydroheatco.com
ZOHO_SMTP_PASS=
# Read replies over IMAP each run (paid Zoho plans only; leave false on the free plan)
ZOHO_IMAP_ENABLED=false
# OVERPASS_URL=https://overpass-api.de/api/interpreter
